# CineMatch ML Engine — Environment Variables

# Data directory (absolute path to the dataset folder)
# Default: ../dataset/cinematch_combined (relative to ml-service/)
CINEMATCH_DATA_DIR=

# Source interaction weights
MOVIELENS_WEIGHT=1.0
INDIAN_WEIGHT=5.0

# Feature cardinality limits
MAX_ACTORS=5000
MAX_DIRECTORS=2000

# LightFM hyperparameters
LIGHTFM_EPOCHS=30
LIGHTFM_THREADS=4
LIGHTFM_CANDIDATE_K=200

# XGBRanker hyperparameters
XGB_ESTIMATORS=500
XGB_LR=0.05
XGB_MAX_DEPTH=8
XGB_MIN_CHILD=5
XGB_EARLY_STOP=50

# Negative sampling
NEGATIVE_RATIO=7

# API server
API_HOST=0.0.0.0
API_PORT=8000
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=5

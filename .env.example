# ==============================================================================
# CineMatch — Master Environment Variables Template (.env.example)
# Copy this file to .env and fill in your values
# ==============================================================================

# --- PostgreSQL Database Configuration ---
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/cinematch
PGUSER=postgres
PGPASSWORD=your_password
PGHOST=localhost
PGPORT=5432
PGDATABASE=cinematch

# --- TMDB API Configuration ---
TMDB_API_KEY=your_tmdb_api_key_here
# TMDB_READ_ACCESS_TOKEN=your_read_access_token
# TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# --- ML Recommendation Service Configuration ---
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=5000
API_HOST=0.0.0.0
API_PORT=8000

# --- ML Model Hyperparameters & Weights ---
MOVIELENS_WEIGHT=1.0
INDIAN_WEIGHT=5.0
MAX_ACTORS=5000
MAX_DIRECTORS=2000
LIGHTFM_EPOCHS=30
LIGHTFM_THREADS=4
LIGHTFM_CANDIDATE_K=200
XGB_ESTIMATORS=500
XGB_LR=0.05
XGB_MAX_DEPTH=8
XGB_MIN_CHILD=5
XGB_EARLY_STOP=50
NEGATIVE_RATIO=7
